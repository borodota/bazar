# Шаблон секретов для сервера.
# На сервере скопировать в /etc/vapebazar-bot.env и вписать реальные значения.
# Этот файл-ШАБЛОН можно хранить в git; сам /etc/vapebazar-bot.env — НЕЛЬЗЯ.

# ── Бот ──
BOT_TOKEN=сюда_токен_бота

# ── Панель 3x-ui (VPN) ──
# BASE_URL включает секретный webBasePath панели — узнать: x-ui settings
XUI_BASE_URL=https://IP_СЕРВЕРА:2053/секретный_путь_панели
XUI_SUB_BASE=https://IP_СЕРВЕРА:2096/sub
XUI_USERNAME=сюда_логин_панели
XUI_PASSWORD=сюда_пароль_панели
# Имя инбаунда в панели (по нему бот сам найдёт нужный):
XUI_INBOUND_REMARK=MyVPN
# Либо, если знаешь точный id инбаунда — раскомментируй и впиши число:
# XUI_INBOUND_ID=1
