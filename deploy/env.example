# Этот файл-ШАБЛОН можно хранить в git; сам /etc/vapebazar-bot.env — НЕЛЬЗЯ.

# ── Бот ──
BOT_TOKEN=сюда_токен_бота

# ── Панель 3x-ui (VPN) ──
XUI_BASE_URL=https://62.133.61.23:2053/KUzeX4i5ljeMdedcxc
XUI_SUB_BASE=https://62.133.61.23:2096/sub
